# GuestSpot environment variables
# Copy to .env and adjust. All values have inline defaults in docker-compose.yml.

# --- Admin superuser (created automatically on first boot) ---
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Public app URL (used for links in emails) ---
PUBLIC_URL=http://localhost:8080

# --- Email notifications (SMTP). Leave SMTP_* empty to disable emails. ---
MAIL_FROM=GuestSpot <noreply@example.com>
MAIL_SENDER_NAME=GuestSpot
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=false
SMTP_AUTH_METHOD=PLAIN
ADMIN_NOTIFY_EMAILS=

# --- Networking ---
WEB_PORT=8080
GUESTSPOT_TAG=latest
