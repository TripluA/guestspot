// Cleanup dangling references: user/spot delete.

onRecordAfterDeleteSuccess((e) => {
  const userId = e.record.id
  // Clear spots.owner
  const spots = e.app.findRecordsByFilter("spots", `owner = "${userId}"`)
  for (const spot of spots) {
    spot.set("owner", "")
    e.app.save(spot)
  }
  // Clear requests.confirmer
  const requests = e.app.findRecordsByFilter("requests", `confirmer = "${userId}"`)
  for (const req of requests) {
    req.set("confirmer", "")
    e.app.save(req)
  }
  e.next()
}, "users")

onRecordAfterDeleteSuccess((e) => {
  const spotId = e.record.id
  // Clear requests.spot
  const requests = e.app.findRecordsByFilter("requests", `spot = "${spotId}"`)
  for (const req of requests) {
    req.set("spot", "")
    e.app.save(req)
  }
  e.next()
}, "spots")
